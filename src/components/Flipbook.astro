---
import PdfFlipbook from "./PDFFlipbook";

const {
  fileUrl,
  width = 600,
  height = 850,
  className = "",
  triggerLabel = "Open flipbook",
} = Astro.props;
---

<PdfFlipbook
  client:only="react"
  fileUrl={fileUrl}
  width={width}
  height={height}
  className={className}
  triggerLabel={triggerLabel}
/>
