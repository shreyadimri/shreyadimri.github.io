---
import GroguHide from '../assets/main-illustrations/grogu-hide.png';
import MandoFrog from '../assets/main-illustrations/mando-frog.png';
import FlowerIcon from '../assets//main-illustrations/flower.png';
import {author} from '../data/author.ts'

const links = [
    { name: 'Publications', path: '/publication/', target: '_self' },
    { name: 'Projects', path: '/projects/', target: '_self' },
    { name:  'Art', path: '/art/', target: '_self' },
    { name: 'Blog', path: '/blog/', target: '_self' },
    { name: 'Contact', path: '/contact/', target: '_self' },
]

const { pathname } = Astro.url
---

<header class="relative border-b-4 p-7 overflow-hidden">
      <div class="flex border-3 border-[var(--lilac)] w-full bg-white max-w-[600px] max-w-[1100px] mx-auto relative z-10">
        <!-- top boxes -->
        <div class="size-2 bg-white border-3 border-[var(--lilac)] absolute -top-2 -right-2"></div>
        <div class="size-2 bg-white border-3 border-[var(--lilac)] absolute -top-2 -left-2"></div>

        <!-- bottom boxes -->
        <div class="size-2 bg-white border-3 border-[var(--lilac)] absolute -bottom-2 -left-2"></div>
        <div class="size-2 bg-white border-3 border-[var(--lilac)] absolute -bottom-2 -right-2"></div>

         <img src={GroguHide.src} alt="png" width="60" 
         class="relative hidden md:block absolute left-273 top-12 transform -translate-y-1/2 pointer-events-none"/>

    
        <nav class="flex w-full items-center justify-between p-1 md:p-0">
            <div class="flex items-center gap-3 flex-shrink-0 font-bold pr-2">
                <a href="/" class="flex items-center gap-3 whitespace-nowrap">
                    <img src={MandoFrog.src} alt="logo" width="56"/> 
                    <span class = "text-[var(--lilac)] font-bold text-[25px] whitespace-nowrap"> {author.name} </span>
                </a>
            </div>
            <div class="flex-1"></div>
            <a href="#" class="flex md:hidden" id="menu-open">
                <i class="ri-menu-2-line text-2xl"></i>
            </a>
            <ul class="hidden md:flex ml-auto items-center">
                {links.map(item => ( 
                    <li class="border-l-2 border-[var(--lilac)] p-4 py-4">
                        <a href={item.path} target={item.target}                                
                        class="whitespace-nowrap relative flex items-center before:content-[''] before:absolute before:left-0 before:bottom-1 before:h-[8px] before:w-0 before:bg-[var(--pink)] before:transition-all before:duration-600 hover:before:w-full">
                            <span class="relative z-5">{item.name} {pathname == item.path ? 
                            (<img src={FlowerIcon.src} alt="active" class="inline-block w-10 h-10" />
                            ): null}
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
  </header>
