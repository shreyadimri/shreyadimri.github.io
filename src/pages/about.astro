---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "About Me";

---
<Layout title={pageTitle}>
    <Header />
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-4">{pageTitle}</h1>
        <p class="mb-4">
            Hello! I'm Shreya Dimri, a passionate researcher, a coding enthusiast and always up for learning. This website is a space where I share my projects, blog posts, and thoughts on things.
        </p>
        <p class="mb-4">
            Feel free to explore and connect with me through the links provided in the header!
        </p>
    </main>
    <Footer />