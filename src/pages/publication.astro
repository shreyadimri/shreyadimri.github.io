---
const pageTitle = "Publications";
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { publications } from "../data/publications";
import Creeper from "../assets/main-illustrations/creeper.png";

// Bold your name wherever it appears
function highlightAuthor(authors: string) {
  return authors.replace(/Dimri S\./g, "<strong>Dimri S.</strong>");
}

// Split + sort into categories
const biology = publications
  .filter((p) => p.category === "biology")
  .sort((a, b) => b.year - a.year);

const openScience = publications
  .filter((p) => p.category === "open-science")
  .sort((a, b) => b.year - a.year);
---

<Layout>
  <Header />

  <!-- Page title / intro -->
  <section class="pb-10 relative">
    <div class="max-w-5xl mx-auto p-4 pt-20 md:pt-20">
      <h1 class="text-5xl md:text-5xl font-black mb-4">Publications</h1>
    </div>
  </section>

  <!-- BIOLOGY RESEARCH -->
  <section class="pb-4 relative">
    <div class="max-w-5xl mx-auto p-4 pt-10 md:pt-5">
      <h2 class="text-3xl md:text-4xl font-semibold mb-8">Biology Research</h2>

      <ul class="space-y-10">
        {
          biology.map((pub) => (
            <li class="relative">

              <!-- NEW TAG CREEPER-->
              {pub.isNew && (
               <div class="absolute -left-34 top-6 flex flex-col items-center">
              <img
               src={Creeper.src}
               alt="New!"
               class="w-24 md:w-32 lg:w-40 drop-shadow-lg"
               />
              </div>
             )} 


              <!-- CARD -->
              <div
                class="bg-white p-5 border-2 mb-5 transition-all duration-200
                       hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]"
              >
                <p
                  class="text-sm text-slate-500 mb-3"
                  set:html={`${highlightAuthor(pub.authors)} (<strong>${pub.year}</strong>)`}
                />
                <p class="font-semibold text-lg mb-3">{pub.title}</p>

                {pub.journal && (
                  <p class="font-bold text-sm text-slate-600 mb-4">
                    {pub.journal}
                  </p>
                )}

                <div class="flex flex-wrap gap-2 text-xs mt-1">
                  {pub.preregLink && (
                    <a
                      href={pub.preregLink}
                      class="px-3 py-1 rounded-full bg-emerald-100 border border-emerald-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Pre-registration
                    </a>
                  )}
                  {pub.preprintLink && (
                    <a
                      href={pub.preprintLink}
                      class="px-3 py-1 rounded-full bg-purple-100 border border-purple-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Preprint
                    </a>
                  )}
                  {pub.publicationLink && (
                    <a
                      href={pub.publicationLink}
                      class="px-3 py-1 rounded-full bg-blue-100 border border-blue-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Article
                    </a>
                  )}
                  {pub.dataLink && (
                    <a
                      href={pub.dataLink}
                      class="px-3 py-1 rounded-full bg-amber-100 border border-amber-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Data
                    </a>
                  )}
                  {pub.codeLink && (
                    <a
                      href={pub.codeLink}
                      class="px-3 py-1 rounded-full bg-rose-100 border border-rose-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Code
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- OPEN SCIENCE & META-RESEARCH -->
  <section class="pb-20 relative"> <div class="max-w-5xl mx-auto p-5 pt-10 md:pt-10"> 
    <h2 class="text-5xl md:text-4xl font-semibold mb-4"> Open Science & Meta-research </h2>
    <p class="mb-8 max-w-5xl"> My contributions aimed at making science more open, transparent, and reproducible, 
      and at understanding how we conduct research and what we can do to improve it. </p>
      <ul class="space-y-10 mb-16">
        {
          openScience.map((pub) => (
            <li class="relative">

              <!-- NEW TAG CREEPER-->
              {pub.isNew && (
               <div class="absolute -left-34 top-6 flex flex-col items-center">
              <img
               src={Creeper.src}
               alt="New!"
               class="w-24 md:w-32 lg:w-40 drop-shadow-lg"
               />
              </div>
             )} 


              <!-- CARD -->
              <div
                class="bg-white p-5 border-2 mb-5 transition-all duration-200
                       hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]"
              >
                <p
                  class="text-sm text-slate-500 mb-3"
                  set:html={`${highlightAuthor(pub.authors)} (<strong>${pub.year}</strong>)`}
                />
                <p class="font-semibold text-lg mb-3">{pub.title}</p>

                {pub.journal && (
                  <p class="font-bold text-sm text-slate-600 mb-4">
                    {pub.journal}
                  </p>
                )}

                <div class="flex flex-wrap gap-2 text-xs mt-1">
                  {pub.preregLink && (
                    <a
                      href={pub.preregLink}
                      class="px-3 py-1 rounded-full bg-emerald-100 border border-emerald-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Pre-registration
                    </a>
                  )}
                  {pub.preprintLink && (
                    <a
                      href={pub.preprintLink}
                      class="px-3 py-1 rounded-full bg-purple-100 border border-purple-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Preprint
                    </a>
                  )}
                  {pub.publicationLink && (
                    <a
                      href={pub.publicationLink}
                      class="px-3 py-1 rounded-full bg-blue-100 border border-blue-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Article
                    </a>
                  )}
                  {pub.dataLink && (
                    <a
                      href={pub.dataLink}
                      class="px-3 py-1 rounded-full bg-amber-100 border border-amber-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Data
                    </a>
                  )}
                  {pub.codeLink && (
                    <a
                      href={pub.codeLink}
                      class="px-3 py-1 rounded-full bg-rose-100 border border-rose-300"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Code
                    </a>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Footer />
</Layout>
