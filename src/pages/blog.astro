---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <body>
 <Header/>
    <h1>Blog Posts</h1>
    <p>This space is my little space on the internet to share with you all what all I have been tinkering with. 
      If you end up reading some of it, please do let me know. A thumbs up or even down would be great for me to 
      know that!</p>
    <ul>
      <li><a href="/blogs/post-1/">Post 1</a></li>
      <li><a href="/blogs/post-2/">Post 2</a></li>
      <li><a href="/blogs/post-3/">Post 3</a></li>
    </ul>
    <Footer />
     <script>
    const menu = document.querySelector('.menu');

    menu.addEventListener('click', () => {
      const isExpanded = menu.getAttribute('aria-expanded') === 'true';
      menu.setAttribute('aria-expanded', !isExpanded);
    });
  </script>
  </body>
</Layout>

