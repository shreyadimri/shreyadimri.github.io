---
const pageTitle = "Art";
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Flipbook from "../components/Flipbook.astro";

// Images for pandemic doodles
const pandemicArt = [
  {
    src: "/src/assets/art/pandemic1.PNG",
    caption: "I might be turning into a house plant slowly.",
  },
  {
    src: "/src/assets/art/pandemic2.PNG",
    caption: "I have joined forces with my phone to master unproductiveness.",
  },
  {
    src: "/src/assets/art/pandemic3.PNG",
    caption:
      "Staring at an empty fridge for hours is a new skill I can put on my CV now.",
  },
  {
    src: "/src/assets/art/pandemic4.PNG",
    caption:
      "I am maintaining strict personal hygeine, cleaning my insides with chai and biscuits.",
  },
  {
    src: "/src/assets/art/pandemic5.PNG",
    caption:
      "I WFH, it involves looking for animals to observe their behaviour.",
  },
  {
    src: "/src/assets/art/pandemic6.PNG",
    caption:
      "I can see the importance of enrichment in captive environment, waiting to be taken out for a walk.",
  },
  {
    src: "/src/assets/art/pandemic7.PNG",
    caption:
      "Mera Ae Charkha Naulakha Kudey, Translation: My spinning wheel darling, is priceless.",
  },
  {
    src: "/src/assets/art/pandemic8.PNG",
    caption: "I have started to doodle, quite literally.",
  },
  {
    src: "/src/assets/art/pandemic9.PNG",
    caption:
      "The dinosaurs have become quite feareless, they are taking over my balcony.",
  },
  {
    src: "/src/assets/art/pandemic10.PNG",
    caption: "A sketch over an image I took over a frozen pond in my garden.",
  },
  {
    src: "/src/assets/art/pandemic11.PNG",
    caption:
      "Saw some incredibly happy puppies make road their playground today. It made me happy, I hope it makes your heart happy too.",
  },
];
---

<Layout>
  <Header />

  <!-- Intro -->
  <section class="pb-10 relative">
    <div class="max-w-5xl mx-auto p-5 pt-20 md:pt-20">
      <h1 class="text-5xl font-black mb-5">Art</h1>
      <p class="text-xl font-medium text-slate-800">
        I love to scribble, something you've probably realised by now. All these
        little doodles that appear on this website and icons that look a little
        whacky are scribbled by me.
        <br /><br />
        I enjoy mixing a bit of art into my science and a little science into my
        art. I am no artist, but I do appreciate things that look beautiful and spark
        some joy. This space is a collection of such things.
      </p>
    </div>
  </section>


    <header class="relative border-b-3 p-5 overflow-hidden"></header>
    
  <!-- Magazines -->
  <section class="pb-20 relative">
    <div class="max-w-5xl mx-auto p-5 pt-10 md:pt-10">
      <h2 class="text-4xl font-semibold mb-8">Magazines</h2>
      <p class="mb-8 max-w-5xl">
        <span class="font-semibold">Imprint</span> is the annual magazine of the
        Department of Zoology at St. Xavier's College, Mumbai, created under the
        Xavier’s Zoology Association to make zoology accessible, engaging, and visually
        compelling. Over the years, the magazine has explored themes such as human–animal
        interactions, migration, climate change, and animal communication.
        <br /><br />
        These editions are especially close to my heart as they were my first serious
        attempt at science communication and design. My journey with Imprint spans
        two issues, but the magazine continues to be published by the department
        every year.
        <br />
        <a
          href="https://sites.google.com/xaviers.edu/xavierszoology/imprint"
          target="_blank"
          class="font-semibold text-slate-900 underline underline-offset-4"
        >
          You can check them out as well!
        </a>
        <br /><br />
        I hope you enjoy flipping through these as much as I enjoyed making them
        several years ago!
      </p>

      <div class="space-y-16">
        <!-- IMPRINT 2018 -->
        <div class="space-y-8">
          <h3 class="text-3xl font-semibold">
            Imprint 2018: A Symphony of Species
          </h3>

          <p class="text-slate-700 max-w-5xl">
            This issue invited readers into the fascinating world of animal
            communication, exploring how signals evolve and shape interactions
            across species. As
            <span class="font-semibold">Student Editor-in-Chief</span> for this edition,
            together with an amazing editorial team, I guided the theme, curated
            content, and contributed to the magazine’s design. It was a fulfilling
            experience to take a magazine from concept to print—holding the hard
            copy in my hands was truly rewarding!
          </p>

          <!-- Read button -->
          <div class="mt-4">
            <Flipbook
              fileUrl="/magazines/Imprint2018.pdf"
              triggerLabel="Read Imprint 2018"
            />
          </div>

          <!-- Magazine overview -->
          <div class="mt-8 inline-block border-2 rounded-xl overflow-hidden">
            <div class="flex">
              <img
                src="/magazines/Imprint2018-cover.jpg"
                alt="Imprint 2018 Cover"
                class="w-65 md:w-68 lg:w-78 object-cover"
              />
              <img
                src="/magazines/Imprint2018-page1.jpg"
                alt="Imprint 2018 Page 1"
                class="w-65 md:w-68 lg:w-78 object-cover"
              />
              <img
                src="/magazines/Imprint2018-page2.jpg"
                alt="Imprint 2018 Page 2"
                class="w-65 md:w-68 lg:w-78 object-cover"
              />
            </div>
          </div>
        </div>

        <!-- IMPRINT 2017 -->
        <div class="space-y-8">
          <h3 class="text-3xl font-semibold">
            Imprint 2017: Of Plato and Platypus
          </h3>

          <p class="text-slate-700 max-w-5xl">
            This issue explored the complex and often misunderstood
            relationships between humans and animals, in both synchrony and
            conflict. I worked on
            <span class="font-semibold">this edition as a Design Editor</span>,
            contributing to the visual language of the magazine and supporting
            the editorial process. It was a delight to work on this issue and to
            learn tools like InDesign along the way!
          </p>

          <!-- Read button -->
          <div class="mt-4">
            <Flipbook
              fileUrl="/magazines/Imprint2017.pdf"
              triggerLabel="Read Imprint 2017"
            />
          </div>

          <!-- Magazine overview -->
          <div class="mt-8 inline-block border-2 rounded-xl overflow-hidden">
            <div class="flex">
              <img
                src="/magazines/Imprint2017-cover.jpg"
                alt="Imprint 2017 Cover"
                class="w-65 md:w-68 lg:w-78 object-cover"
              />
              <img
                src="/magazines/Imprint2017-page1.jpg"
                alt="Imprint 2017 Page 1"
                class="w-65 md:w-68 lg:w-78 object-cover"
              />
              <img
                src="/magazines/Imprint2017-page2.jpg"
                alt="Imprint 2017 Page 2"
                class="w-65 md:w-68 lg:w-78 object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <header class="relative border-b-3 p-5 overflow-hidden"></header>

  <!--Project PANDEMIC ART -->
  <section class="pb-25 relative">
    <div class="max-w-5xl mx-auto p-5 pt-10 md:pt-10">
      <h2 class="text-4xl font-semibold mb-8">Pandemic Doodles</h2>
      <p class="mb-8 max-w-5xl">
        <span class="font-semibold">
          Covid-2019 Pandemic was a difficult time in many ways for everyone. I
          spent months locked up in my house, unable to go out and do much. To
          keep myself occupied, I started doodling about my boredom and my
          little observations of the world around me. It kept my boredom low and
          my spirits high. Here are some of those doodles that I made during
          that time. Enjoy!
        </span>
      </p>

      <!-- Image carousel -->
      <div class="relative">
        <!-- Left arrow -->
        <button
          type="button"
          class="flex items-center justify-center w-9 h-9 md:w-10
  md:h-10 rounded-full bg-white/80 shadow
  border border-slate-300 absolute left-0 top-1/2
  -translate-y-1/2 -translate-x-1/2 hover:bg-white
  transition z-10"
          data-carousel="pandemic"
          data-dir="prev"
          aria-label="Previous doodles"
        >
          ‹
        </button>

        <!-- Scrollable track -->
        <div
          id="pandemic-carousel"
          class="flex gap-2 overflow-x-auto scroll-smooth snap-4x snap-mandatory pb-4"
        >
          {
            pandemicArt.map((item, index) => (
              <button
                type="button"
                class="snap-start shrink-0 w-64 h-64 md:w-72 md:h-72 
                rounded-2xl bg-slate-100 overflow-hidden 
                border border-slate-300 focus:outline-none 
                focus:ring-2 focus:ring-offset-2 
                focus:ring-slate-500"
                data-pandemic-image
                data-fullsrc={item.src}
                data-caption={item.caption}
                data-index={index}
              >
                <img
                  src={item.src}
                  alt={`Pandemic doodle ${index + 1}`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </button>
            ))
          }
        </div>

        <!-- Right arrow -->
        <button
          type="button"
          class="flex items-center justify-center
  w-9 h-9 md:w-10 md:h-10 rounded-full bg-white/80
  shadow border border-slate-300 absolute right-0 top-1/2
  -translate-y-1/2 translate-x-1/2 hover:bg-white
  transition z-10"
          data-carousel="pandemic"
          data-dir="next"
          aria-label="Next doodles"
        >
          ›
        </button>
      </div>
    </div>

    <!-- Lightbox modal -->
    <div
      id="pandemic-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70"
      aria-hidden="true"
    >
      <div class="relative max-w-3xl mx-auto p-4 md:p-6 w-full">
        <!-- Clickable backdrop area outside card (handled in JS as well) -->
        <button
          type="button"
          id="pandemic-modal-backdrop"
          class="absolute inset-0 w-full h-full cursor-default"
          aria-hidden="true"></button>

        <div class="relative bg-white rounded-4xl shadow-xl overflow-hidden">
          <button
            type="button"
            id="pandemic-modal-close"
            class="absolute top-3 right-3 inline-flex items-center 
            justify-center w-6 h-6 rounded-full 
            bg-white/90 border border-slate-200 
            text-slate-700 hover:bg-white 
            hover:text-slate-900 shadow"
            aria-label="Close image"
          >
            ✕
          </button>

          <figure class="flex flex-col">
            <img
              id="pandemic-modal-image"
              src=""
              alt=""
              class="w-full max-h-[70vh] object-contain bg-slate-100"
              loading="lazy"
            />
            <figcaption
              id="pandemic-modal-caption"
              class="p-4 text-slate-700 text-sm md:text-base"
            >
              <!-- caption will be injected via JS -->
            </figcaption>
          </figure>
        </div>
      </div>
    </div>

    <script is:inline>
      // Carousel arrows
      const container = document.querySelector("#pandemic-carousel");
      const buttons = document.querySelectorAll('[data-carousel="pandemic"]');

      if (container && buttons.length) {
        const getStep = () => {
          const firstCard = container.querySelector("[data-pandemic-image]");
          return (
            firstCard?.getBoundingClientRect().width ||
            container.clientWidth * 0.8
          );
        };

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const dir = btn.dataset.dir === "next" ? 1 : -1;
            const step = getStep();
            container.scrollBy({
              left: dir * step,
              behavior: "smooth",
            });
          });
        });
      }

      // Lightbox / modal
      const imageButtons = document.querySelectorAll("[data-pandemic-image]");
      const modal = document.querySelector("#pandemic-modal");
      const modalImg = document.querySelector("#pandemic-modal-image");
      const modalCaption = document.querySelector("#pandemic-modal-caption");
      const modalClose = document.querySelector("#pandemic-modal-close");
      const modalBackdrop = document.querySelector("#pandemic-modal-backdrop");

      const openModal = (src, caption, alt) => {
        if (!modal || !modalImg || !modalCaption) return;
        modalImg.src = src;
        modalImg.alt = alt;
        modalCaption.textContent = caption || "";
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
      };

      const closeModal = () => {
        if (!modal || !modalImg) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modalImg.src = "";
        document.body.style.overflow = "";
      };

      imageButtons.forEach((btn, index) => {
        btn.addEventListener("click", () => {
          const src = btn.dataset.fullsrc || "";
          const caption = btn.dataset.caption || "";
          const alt = `Pandemic doodle ${index + 1}`;
          openModal(src, caption, alt);
        });
      });

      modalClose?.addEventListener("click", closeModal);
      modalBackdrop?.addEventListener("click", closeModal);

      // Close on Escape
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeModal();
        }
      });
    </script>
  </section>
  <Footer />
</Layout>
