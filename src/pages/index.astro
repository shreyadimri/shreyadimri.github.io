---
const pageTitle = "Home";
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import About from '../components/About.astro';
import sdMain from '../assets/images/SD-Main.png';
import CirclePointer from '../assets/icons/circle-pointer.png';
import GroguHello from '../assets/main-illustrations/grogu-hello.png';
import {author} from '../data/author.ts'
---

<Layout>
  <Header />
   <!-- Hello and my image -->
  <section class="pb-20 relative">
  <div class="max-w-5xl mx-auto p-4 pt-20 md:pt-30">
      <div class="grid grid-cols-1 md:grid-cols-[60%_50%] items-center">
        <div class="flex flex-col gap-4 pr-0 md:pr-20">
          <h1 class="text-4xl font-medium">
            <img src={GroguHello.src} alt="logo" width="120" /> 
              <span>Good to see you here!</span>
          </h1>
          <p class="text-xl">
            Researcher in 
            <span class="relative inline-block mx-1">
              <span class="absolute left-0 bottom-0 w-full h-[55%] bg-[var(--yellow)] z-0"></span>
              <span class="relative z-10">Behavioural Ecology</span>
            </span>
            and Evolution with focus on Evidence synthesis — Systematic reviews and 
            <span class="relative inline-block mx-1">
              <span class="absolute left-0 bottom-0 w-full h-[55%] bg-[var(--yellow)] z-0"></span>
              <span class="relative z-10">Meta-analysis.</span>
            </span>
            <span class="relative inline-block ml-1">
              <span class="absolute left-0 bottom-0 w-full h-[55%] bg-[var(--yellow)] z-0"></span>
              <span class="relative z-10">Open Sciencer!</span>
            </span>
          </p>
          <div class="flex mt-5">
             <Button text="See my Current Projects" link="/projects" target="_self" />
          </div>
        </div>
      <div class="relative mt-40 md:mt-0">
  <!-- main photo -->
  <img src={sdMain.src} alt="photo" width="500" class="w-full max-w-[400px] mx-auto" />

  <!-- annotation: bubble and text -->
     <div class="absolute -top-28 left-10 z-10 md:-top-32 md:left-8 transform -rotate-[-20deg]">
      <div class="relative w-36 md:w-44 lg:w-48">
        <!-- pointer graphic-->
        <img src={CirclePointer.src} alt="pointer" class="w-full" />
        <!-- text positioned inside bubble-->
        <span class="absolute font-medium text-sm md:text-base top-[48%] left-[50%] 
        -translate-x-1/2 -translate-y-1/2 -rotate-40 whitespace-nowrap">It’s me! {author.nickname}!</span>
      </div>
     </div>
      </div>
    </div>
  </div> 
  <header class="relative border-b-4 p-3 overflow-hidden"></header>
 </section>

 <section class="pb-20 relative">
      <div class="max-w-5xl mx-auto p-5 pt-20 md:pt-30">
         <About/>
            <div class="flex mt-15">
             <Button text="Detailed CV" link="/projects" target="_self" />
            </div>
      </div>
  </section>
  <Footer/>
</Layout>
